{
  "name": "creation-forge",
  "version": "0.1.0",
  "private": true,
  "description": "造化坊 - 基于项目制学习的人机协作独立游戏开发工作室",
  "workspaces": [
    "shared/*",
    "projects/originals/*",
    "projects/sandbox/*"
  ],
  "scripts": {
    "dashboard": "npx tsx tools/dashboard-server.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "scaffold": "npx tsx tools/scaffold-game.ts",
    "journal": "npx tsx tools/new-journal.ts",
    "stitch": "node stitch-test.mjs",
    "stitch-ui": "node stitch-test.mjs",
    "build-spec": "npx tsx projects/interaction-spec-system/tools/build-interaction-spec.ts"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "exceljs": "^4.4.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "undici": "^8.9.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "express": "^5.2.1"
  }
}

{
  "verdict": {
    "summary": "并非像素级完全一致，而是「同素材、同信息结构的近似复刻」。",
    "counts": {
      "一致": 1,
      "基本一致": 5,
      "部分一致": 6,
      "不一致/其他": 4
    },
    "headline": "结构与文案大体对齐，布局引擎不同（VBox vs 绝对坐标）+ 运行时控件/动态商店/关卡窗导致无法与 Pixso 静帧 1:1。"
  },
  "matrix": [
    {
      "screen": "Menu",
      "aspect": "画布尺寸",
      "status": "一致",
      "detail": "Pixso 450x800 / Godot 450x800"
    },
    {
      "screen": "Menu",
      "aspect": "主文案内容",
      "status": "基本一致",
      "detail": "标题/副标题/开始游戏文案对齐；Godot MenuStats 运行时数字，Pixso 用示意 12840/1280"
    },
    {
      "screen": "Menu",
      "aspect": "布局模型",
      "status": "不一致",
      "detail": "Godot=居中 VBox 流式；Pixso=绝对坐标近似。同屏观感接近，但坐标不会 1:1"
    },
    {
      "screen": "Menu",
      "aspect": "角色五卡",
      "status": "不一致/Pixso多",
      "detail": "Pixso G01 有五角色立绘+名；Godot 主菜单场景无此固定行，仅有代码生成的角色切换按钮"
    },
    {
      "screen": "Menu",
      "aspect": "背景与蹦床/角色PNG",
      "status": "部分一致",
      "detail": "双方都用同一套 assets PNG 意图；Pixso 为静帧拼贴，Godot 为场景节点实时组合"
    },
    {
      "screen": "InGame",
      "aspect": "HUD 结构",
      "status": "基本一致",
      "detail": "关卡/分/币/命四格+目标文案；Godot 图标 TextureRect 16px，Pixso 同素材"
    },
    {
      "screen": "InGame",
      "aspect": "玩法层",
      "status": "部分一致",
      "detail": "Paddle(225,650)/Ball 静帧可对齐；Godot BrickHost 动态关卡，Pixso 为示意窗格"
    },
    {
      "screen": "InGame",
      "aspect": "虚拟键/技能",
      "status": "部分一致",
      "detail": "均为运行时/示意控件；Godot 代码生成，Pixso 有近似块"
    },
    {
      "screen": "InGame",
      "aspect": "特效",
      "status": "刻意不一致",
      "detail": "约定不复刻粒子拖尾等"
    },
    {
      "screen": "LevelClear+Shop",
      "aspect": "结算文案/按钮",
      "status": "基本一致",
      "detail": "扑灭成功/双倍/下一关存在；Godot 商店为过关后代码构建"
    },
    {
      "screen": "LevelClear+Shop",
      "aspect": "布局",
      "status": "部分一致",
      "detail": "Godot VBox+动态 shop_panel；Pixso 绝对 shop-box，易与真实按钮矩形有偏差"
    },
    {
      "screen": "GameOver",
      "aspect": "文案与按钮集合",
      "status": "基本一致",
      "detail": "Pixso texts=8"
    },
    {
      "screen": "GameOver",
      "aspect": "精确像素布局",
